# whelk -- a Wayland shell written in Rust, GTK4 and GNU Guile Scheme
#
# SPDX-License-Identifier: MIT
# Copyright © Josep Bigorra <jjbigorra@gmail.com>

# Maintainer: Josep Bigorra <jjbigorra@gmail.com>
pkgname=whelk
pkgver=0.39.1
pkgrel=1
pkgdesc="Wayland shell with bars, a launcher and notifications, configured in Guile Scheme"
arch=('x86_64' 'aarch64')
url="https://github.com/jjba23/whelk"
license=('MIT')

depends=(
  'glib2'
  'gtk4'
  'gtk4-layer-shell'
  'guile'
  'pam'
  'wtype'
  'wayland'
)

makedepends=(
  'cargo'
  'rust'
  'pkgconf'
  'xorg-server-xvfb'
)

source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/${pkgname}-${pkgver}"

  cargo build --release --locked --bin whelk
}

check() {
  cd "$srcdir/${pkgname}-${pkgver}"
  xvfb-run -a cargo test --workspace --locked
}

package() {
  cd "$srcdir/${pkgname}-${pkgver}"

  cargo xtask install --prefix=/usr --destdir="$pkgdir" --no-build
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
